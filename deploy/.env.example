# EventOS — variables de entorno del backend (API)
# Copia este archivo a /etc/eventos/eventos.env (chmod 600, dueño root)
# El instalador (deploy/install.sh) lo genera automáticamente.

# Bind y entorno
HOST=127.0.0.1            # la API escucha solo en localhost; nginx la expone
PORT=4010
NODE_ENV=production

# Bus de eventos (Redis). Vacío = fallback en memoria (el server arranca igual).
REDIS_URL=redis://127.0.0.1:6379

# Token de ingesta de dispositivos (webhooks). Lo envían las cámaras/alarmas
# por header X-Ingest-Token o como ?token= en la URL. Genéralo con:
#   echo "ingest_$(openssl rand -hex 24)"
INGEST_TOKEN=CAMBIAR_token_de_ingesta

# Token de administración. OBLIGATORIO en producción: sin él, /api/admin queda
# ABIERTO (dump de config con credenciales, CRUD, scan). El server ABORTA el
# arranque en producción si falta (salvo ALLOW_OPEN_ADMIN=1, sólo para pruebas).
#   echo "admin_$(openssl rand -hex 24)"
ADMIN_TOKEN=CAMBIAR_token_de_admin

# Clave de cifrado en reposo (AES-256-GCM) de las contraseñas de equipos.
# ⚠️ Si se pierde, los valores cifrados son IRRECUPERABLES — respaldá este archivo.
#   openssl rand -hex 32
ENC_KEY=CAMBIAR_clave_de_cifrado_hex_32_bytes

# Cookie de sesión Secure (solo HTTPS). Poner en 1 cuando la instancia va por TLS.
SESSION_SECURE=1

# Origen permitido para CORS. En producción: el dominio de nginx (https://eventos.tudominio).
# '*' permite cualquier origen (solo recomendable en LAN cerrada / demo).
CORS_ORIGIN=*
